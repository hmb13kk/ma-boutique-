<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ma Boutique</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f5f5;
    color: #111;
}

header {
    background: #111;
    color: white;
    padding: 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: sticky;
    top: 0;
    z-index: 10;
}

.logo {
    font-size: 24px;
    font-weight: bold;
}

.cart-button {
    background: white;
    color: #111;
    border: none;
    padding: 12px 18px;
    border-radius: 8px;
    cursor: pointer;
    font-weight: bold;
}

.hero {
    text-align: center;
    padding: 60px 20px;
    background: linear-gradient(135deg, #111, #333);
    color: white;
}

.hero h1 {
    font-size: 42px;
    margin-bottom: 15px;
}

.hero p {
    font-size: 18px;
}

.products {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
}

.products h2 {
    text-align: center;
    margin-bottom: 30px;
    font-size: 30px;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 25px;
}

.product {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px rgba(0,0,0,0.1);
}

.product img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    display: block;
}

.product-info {
    padding: 20px;
}

.product h3 {
    font-size: 20px;
    margin-bottom: 10px;
}

.price {
    font-size: 22px;
    font-weight: bold;
    margin-bottom: 15px;
}

.add-button {
    width: 100%;
    padding: 13px;
    border: none;
    background: #111;
    color: white;
    border-radius: 8px;
    cursor: pointer;
    font-size: 16px;
    font-weight: bold;
}

.add-button:hover {
    background: #333;
}

.cart {
    position: fixed;
    right: -400px;
    top: 0;
    width: 380px;
    max-width: 100%;
    height: 100%;
    background: white;
    z-index: 20;
    box-shadow: -5px 0 20px rgba(0,0,0,0.2);
    padding: 25px;
    transition: right 0.3s;
    overflow-y: auto;
}

.cart.open {
    right: 0;
}

.cart-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 25px;
}

.close-cart {
    border: none;
    background: #eee;
    padding: 8px 12px;
    border-radius: 6px;
    cursor: pointer;
}

.cart-item {
    border-bottom: 1px solid #ddd;
    padding: 15px 0;
}

.cart-item strong {
    display: block;
    margin-bottom: 5px;
}

.remove-button {
    margin-top: 8px;
    border: none;
    background: #e53935;
    color: white;
    padding: 7px 10px;
    border-radius: 5px;
    cursor: pointer;
}

.total {
    font-size: 22px;
    font-weight: bold;
    margin: 25px 0;
}

.order-button {
    width: 100%;
    padding: 15px;
    border: none;
    background: #16a34a;
    color: white;
    border-radius: 8px;
    font-size: 17px;
    font-weight: bold;
    cursor: pointer;
}

footer {
    margin-top: 60px;
    background: #111;
    color: white;
    text-align: center;
    padding: 25px;
}

@media (max-width: 600px) {
    .hero h1 {
        font-size: 32px;
    }

    .cart {
        width: 100%;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">MA BOUTIQUE</div>

    <button class="cart-button" onclick="openCart()">
        🛒 Panier (<span id="cart-count">0</span>)
    </button>
</header>

<section class="hero">
    <h1>Bienvenue sur Ma Boutique</h1>
    <p>Chaussures et parfums à petits prix</p>
</section>

<section class="products">

    <h2>Nos produits</h2>

    <div class="product-grid">

        <!-- PRODUIT 1 -->
        <div class="product">
            <img src="IMG-20260927-WA0003.jpg" alt="ASICS Kayano 14">

            <div class="product-info">
                <h3>ASICS Kayano 14</h3>
                <div class="price">70 €</div>

                <button class="add-button"
                onclick="addToCart('ASICS Kayano 14', 70)">
                    Ajouter au panier
                </button>
            </div>
        </div>

        <!-- PRODUIT 2 -->
        <div class="product">
            <img src="IMG-20260927-WA0001.jpg" alt="Saucony">

            <div class="product-info">
                <h3>Saucony</h3>
                <div class="price">70 €</div>

                <button class="add-button"
                onclick="addToCart('Saucony', 70)">
                    Ajouter au panier
                </button>
            </div>
        </div>

        <!-- PRODUIT 3 -->
        <div class="product">
            <img src="IMG-20260927-WA0000.jpg" alt="Parfum">

            <div class="product-info">
                <h3>Parfum</h3>
                <div class="price">15 €</div>

                <button class="add-button"
                onclick="addToCart('Parfum', 15)">
                    Ajouter au panier
                </button>
            </div>
        </div>

        <!-- PRODUIT 4 -->
        <div class="product">
            <img src="IMG-20260927-WA0002.jpg" alt="Parfum">

            <div class="product-info">
                <h3>Parfum</h3>
                <div class="price">15 €</div>

                <button class="add-button"
                onclick="addToCart('Parfum', 15)">
                    Ajouter au panier
                </button>
            </div>
        </div>

    </div>
</section>

<!-- PANIER -->

<div class="cart" id="cart">

    <div class="cart-header">
        <h2>Mon panier</h2>

        <button class="close-cart" onclick="closeCart()">
            ✕
        </button>
    </div>

    <div id="cart-items">
        <p>Votre panier est vide.</p>
    </div>

    <div class="total">
        Total : <span id="cart-total">0</span> €
    </div>

    <button class="order-button" onclick="checkout()">
        Commander
    </button>

</div>

<footer>
    © 2026 Ma Boutique - Tous droits réservés
</footer>

<script>

let cart = [];

function addToCart(name, price) {

    cart.push({
        name: name,
        price: price
    });

    updateCart();

    alert(name + " a été ajouté au panier !");
}

function updateCart() {

    const cartItems = document.getElementById("cart-items");
    const cartCount = document.getElementById("cart-count");
    const cartTotal = document.getElementById("cart-total");

    cartCount.textContent = cart.length;

    if (cart.length === 0) {

        cartItems.innerHTML = "<p>Votre panier est vide.</p>";

        cartTotal.textContent = "0";

        return;
    }

    let total = 0;

    cartItems.innerHTML = "";

    cart.forEach((item, index) => {

        total += item.price;

        cartItems.innerHTML += `
            <div class="cart-item">
                <strong>${item.name}</strong>
                <span>${item.price} €</span>
                <br>
                <button class="remove-button"
                onclick="removeFromCart(${index})">
                    Supprimer
                </button>
            </div>
        `;
    });

    cartTotal.textContent = total;
}

function removeFromCart(index) {

    cart.splice(index, 1);

    updateCart();
}

function openCart() {

    document.getElementById("cart").classList.add("open");
}

function closeCart() {

    document.getElementById("cart").classList.remove("open");
}

function checkout() {

    if (cart.length === 0) {

        alert("Votre panier est vide.");

        return;
    }

    alert(
        "Votre commande est prête !\n\n" +
        "Le paiement sera ajouté prochainement."
    );
}

</script>

</body>
</html>
