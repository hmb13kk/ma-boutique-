<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>HMB SHOP</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }

        body {
            background: #f5f5f5;
            color: #111;
        }

        /* MENU */
        header {
            background: #111;
            color: white;
            padding: 18px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        header h1 {
            font-size: 25px;
        }

        nav a {
            color: white;
            text-decoration: none;
            margin-left: 18px;
            font-weight: bold;
        }

        nav a:hover {
            color: #ccc;
        }

        /* ACCUEIL */
        .hero {
            min-height: 450px;
            background: linear-gradient(135deg, #111, #444);
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 30px;
        }

        .hero h2 {
            font-size: 48px;
            margin-bottom: 15px;
        }

        .hero p {
            font-size: 20px;
            margin-bottom: 30px;
        }

        .btn {
            background: white;
            color: #111;
            border: none;
            padding: 14px 28px;
            border-radius: 30px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

        .btn:hover {
            background: #ddd;
        }

        /* SECTIONS */
        section {
            padding: 60px 7%;
        }

        section h2 {
            text-align: center;
            font-size: 32px;
            margin-bottom: 40px;
        }

        /* PRODUITS */
        .produits {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
            gap: 25px;
            max-width: 1100px;
            margin: auto;
        }

        .produit {
            background: white;
            border-radius: 15px;
            padding: 18px;
            text-align: center;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            transition: 0.3s;
        }

        .produit:hover {
            transform: translateY(-5px);
        }

        .produit img {
            width: 100%;
            height: 250px;
            object-fit: contain;
            border-radius: 10px;
            margin-bottom: 10px;
        }

        .produit h3 {
            font-size: 20px;
            margin: 10px 0;
        }

        .description {
            color: #666;
            margin-bottom: 10px;
        }

        .prix {
            font-size: 23px;
            font-weight: bold;
            margin: 15px 0;
        }

        .acheter {
            background: #111;
            color: white;
            border: none;
            padding: 12px 20px;
            border-radius: 8px;
            cursor: pointer;
            font-weight: bold;
        }

        .acheter:hover {
            background: #333;
        }

        /* PANIER */
        #panier {
            background: #e9e9e9;
        }

        #listePanier {
            max-width: 750px;
            margin: auto;
        }

        .article-panier {
            background: white;
            padding: 18px;
            margin: 10px 0;
            border-radius: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .supprimer {
            background: #d00000;
            color: white;
            border: none;
            padding: 7px 10px;
            border-radius: 6px;
            cursor: pointer;
            margin-left: 10px;
        }

        .total {
            text-align: center;
            font-size: 27px;
            font-weight: bold;
            margin: 30px;
        }

        .commande {
            display: block;
            margin: auto;
            background: #111;
            color: white;
            border: none;
            padding: 15px 35px;
            border-radius: 10px;
            font-size: 17px;
            font-weight: bold;
            cursor: pointer;
        }

        .commande:hover {
            background: #333;
        }

        /* FOOTER */
        footer {
            background: #111;
            color: white;
            text-align: center;
            padding: 30px;
        }

        /* MOBILE */
        @media (max-width: 700px) {

            header {
                flex-direction: column;
                gap: 15px;
            }

            nav {
                display: flex;
                flex-wrap: wrap;
                justify-content: center;
                gap: 10px;
            }

            nav a {
                margin: 0 5px;
            }

            .hero h2 {
                font-size: 36px;
            }

            .hero p {
                font-size: 17px;
            }

            section {
                padding: 45px 5%;
            }

            .article-panier {
                flex-direction: column;
                gap: 10px;
                text-align: center;
            }
        }
    </style>
</head>


<body>

<!-- MENU -->
<header>

    <h1>HMB SHOP</h1>

    <nav>
        <a href="#accueil">Accueil</a>
        <a href="#produits">Produits</a>
        <a href="#parfums">Parfums</a>
        <a href="#chaussures">Chaussures</a>
        <a href="#panier">🛒 Panier</a>
    </nav>

</header>


<!-- ACCUEIL -->
<section class="hero" id="accueil">

    <h2>Bienvenue chez HMB SHOP</h2>

    <p>
        Parfums et sneakers à petits prix
    </p>

    <a href="#produits">
        <button class="btn">
            Découvrir les produits
        </button>
    </a>

</section>


<!-- TOUS LES PRODUITS -->
<section id="produits">

    <h2>Nos produits</h2>

    <div class="produits">


        <!-- PARFUM -->
        <div class="produit">

            <img src="parfum.jpg" alt="Parfum">

            <h3>Parfum Vanille</h3>

            <p class="description">
                Parfum élégant et agréable.
            </p>

            <div class="prix">
                15 €
            </div>

            <button
                class="acheter"
                onclick="ajouterPanier('Parfum Vanille', 15)">
                Ajouter au panier
            </button>

        </div>


        <!-- ASICS -->
        <div class="produit">

            <img src="kayano.jpg" alt="ASICS Kayano 14">

            <h3>ASICS Kayano 14</h3>

            <p class="description">
                Sneakers tendance et confortables.
            </p>

            <div class="prix">
                70 €
            </div>

            <button
                class="acheter"
                onclick="ajouterPanier('ASICS Kayano 14', 70)">
                Ajouter au panier
            </button>

        </div>


        <!-- SAUCONY -->
        <div class="produit">

            <img src="saucony.jpg" alt="Saucony">

            <h3>Saucony</h3>

            <p class="description">
                Sneakers modernes et confortables.
            </p>

            <div class="prix">
                70 €
            </div>

            <button
                class="acheter"
                onclick="ajouterPanier('Saucony', 70)">
                Ajouter au panier
            </button>

        </div>

    </div>

</section>


<!-- PARFUMS -->
<section id="parfums">

    <h2>🌸 Parfums</h2>

    <div class="produits">

        <div class="produit">

            <img src="parfum.jpg" alt="Parfum">

            <h3>Parfum Vanille</h3>

            <p class="description">
                Parfum de qualité.
            </p>

            <div class="prix">
                15 €
            </div>

            <button
                class="acheter"
                onclick="ajouterPanier('Parfum Vanille', 15)">
                Ajouter au panier
            </button>

        </div>

    </div>

</section>


<!-- CHAUSSURES -->
<section id="chaussures">

    <h2>👟 Chaussures</h2>

    <div class="produits">


        <!-- ASICS -->
        <div class="produit">

            <img src="kayano.jpg" alt="ASICS Kayano 14">

            <h3>ASICS Kayano 14</h3>

            <p class="description">
                Sneakers ASICS tendance.
            </p>

            <div class="prix">
                70 €
            </div>

            <button
                class="acheter"
                onclick="ajouterPanier('ASICS Kayano 14', 70)">
                Ajouter au panier
            </button>

        </div>


        <!-- SAUCONY -->
        <div class="produit">

            <img src="saucony.jpg" alt="Saucony">

            <h3>Saucony</h3>

            <p class="description">
                Sneakers Saucony tendance.
            </p>

            <div class="prix">
                70 €
            </div>

            <button
                class="acheter"
                onclick="ajouterPanier('Saucony', 70)">
                Ajouter au panier
            </button>

        </div>

    </div>

</section>


<!-- PANIER -->
<section id="panier">

    <h2>🛒 Mon panier</h2>

    <div id="listePanier">

        <p style="text-align:center;">
            Ton panier est vide.
        </p>

    </div>

    <div class="total">

        Total :
        <span id="total">
            0.00
        </span>
        €

    </div>

    <button
        class="commande"
        onclick="commander()">

        Commander

    </button>

</section>


<!-- PIED DE PAGE -->
<footer>

    <p>
        © 2026 HMB SHOP
    </p>

    <p>
        Parfums • ASICS • Saucony
    </p>

</footer>


<script>

    /* PANIER */

    let panier = [];


    /* AJOUTER UN PRODUIT */

    function ajouterPanier(nom, prix) {

        panier.push({
            nom: nom,
            prix: prix
        });

        afficherPanier();

        alert(
            nom + " a été ajouté au panier !"
        );
    }


    /* AFFICHER LE PANIER */

    function afficherPanier() {

        const liste =
            document.getElementById("listePanier");

        const total =
            document.getElementById("total");

        liste.innerHTML = "";

        let montantTotal = 0;


        /* PANIER VIDE */

        if (panier.length === 0) {

            liste.innerHTML =
                "<p style='text-align:center;'>Ton panier est vide.</p>";

        }


        /* PRODUITS */

        panier.forEach(function(article, index) {

            montantTotal += article.prix;


            liste.innerHTML += `

                <div class="article-panier">

                    <span>
                        <strong>
                            ${article.nom}
                        </strong>

                        -
                        ${article.prix.toFixed(2)} €
                    </span>


                    <button
                        class="supprimer"
                        onclick="supprimer(${index})">

                        Supprimer

                    </button>

                </div>

            `;

        });


        total.textContent =
            montantTotal.toFixed(2);

    }


    /* SUPPRIMER */

    function supprimer(index) {

        panier.splice(index, 1);

        afficherPanier();

    }


    /* COMMANDER */

    function commander() {

        if (panier.length === 0) {

            alert(
                "Ton panier est vide."
            );

            return;
        }


        alert(
            "Ta commande est prête ! Le paiement sera ajouté prochainement."
        );

    }

</script>

</body>
</html>
